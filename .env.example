# Copy to .env.local and fill in real values. Do NOT commit .env.local.
#
# Neon: https://console.neon.tech — create a project, copy the POOLED connection string.
# The pooled URL ends with -pooler.<region>.aws.neon.tech and is required for serverless.
# For migrations you usually want the DIRECT (non-pooled) URL as well.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Server-side log level. Pino accepts: trace, debug, info, warn, error, fatal.
LOG_LEVEL="info"
