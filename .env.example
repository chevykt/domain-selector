# Copy to .env.local and fill in real values. Do NOT commit .env.local.
#
# Neon: https://console.neon.tech — create a project, copy the connection string.
#
# DATABASE_URL must be the POOLED endpoint (host has "-pooler" in it). Used
# at runtime by the Next.js app and Vercel serverless functions.
#
# DIRECT_URL must be the DIRECT (non-pooled) endpoint. Used by Prisma
# migrate to acquire the migration advisory lock — pooled connections
# can't hold session state and time out on the lock attempt.
#
# Both URLs reference the same database; only the hostname differs.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Server-side log level. Pino accepts: trace, debug, info, warn, error, fatal.
LOG_LEVEL="info"
